# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/incident-tracker

# JWT
# Access token is short-lived — it's sent on every request, so a leaked one
# is only useful for a short window. Sessions stay alive via the refresh
# token instead (see below).
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=15m

# Refresh token — long-lived, used only to mint new access tokens via
# POST /auth/refresh. Must be a DIFFERENT secret than JWT_SECRET so a leaked
# access token can't be used to forge a refresh token.
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# CORS — set to your frontend URL in staging/production
CORS_ORIGIN=http://localhost:5173

# File Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Logging
LOG_LEVEL=info
LOG_DIR=logs
